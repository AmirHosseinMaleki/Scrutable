---
import Base from '../../layouts/Base.astro';
import CompareIsland from '../../components/CompareIsland.tsx';
import CompareStatic from '../../components/CompareStatic.astro';
import type { CompareCandidate, CompareLine, CompareTopic } from '../../lib/compare';
import { oldestChecked } from '../../lib/sources';
import { getCandidates, getCountries, getTopics, getUpcomingElection } from '../../lib/content';

export async function getStaticPaths() {
  return (await getCountries()).map((c) => ({ params: { country: c.slug } }));
}

const slug = Astro.params.country!;
const election = await getUpcomingElection(slug);
const people = await getCandidates(election.slug);
const topics: CompareTopic[] = (await getTopics(slug)).map((t) => ({ slug: t.slug, name: t.name, description: t.description }));

// Plain, serialisable data for the island. Candidates are already in alphabetical order.
const candidates: CompareCandidate[] = people.map((c) => ({
  slug: c.slug,
  name: c.person.name,
  photo: c.person.photo?.file,
  lines: Object.fromEntries(
    c.candidacy.positions.map((p): [string, CompareLine] => [
      p.topic,
      p.status === 'found'
        ? { status: 'found', summary: p.summary, quote: p.quote, quote_lang: p.quote_lang, source_url: p.source_url, source_date: p.source_date, last_checked: p.last_checked }
        : { status: 'not_found', checked_on: p.checked_on },
    ]),
  ),
}));
---

<Base title="Compare" country={slug} lastChecked={oldestChecked(...people.map((c) => c.candidacy))}>
  <h1 class="text-3xl font-semibold tracking-tight">Compare</h1>
  <p class="mt-3 max-w-prose text-muted">Pick a topic to see one line per candidate. Candidates are in alphabetical order.</p>

  <CompareIsland client:load country={slug} topics={topics} candidates={candidates} />
  <noscript><CompareStatic country={slug} topics={topics} candidates={candidates} /></noscript>
</Base>
