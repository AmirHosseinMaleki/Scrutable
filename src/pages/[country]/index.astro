---
import Base from '../../layouts/Base.astro';
import ExplainerCard from '../../components/ExplainerCard.astro';
import SourceLink from '../../components/SourceLink.astro';
import StepList from '../../components/StepList.astro';
import { formatDate } from '../../lib/dates';
import { oldestChecked } from '../../lib/sources';
import { getCountries, getCountry, getUpcomingElection } from '../../lib/content';

export async function getStaticPaths() {
  return (await getCountries()).map((c) => ({ params: { country: c.slug } }));
}

const { country: slug } = Astro.params;
const country = await getCountry(slug!);
const election = await getUpcomingElection(slug!);
const dates = [...election.key_dates].sort((a, b) => a.date.localeCompare(b.date));
const links = [
  { href: `/${slug}/candidates/`, label: 'Candidates', text: 'Who is running.' },
  { href: `/${slug}/compare/`, label: 'Compare', text: 'One topic, every candidate.' },
  { href: `/${slug}/story/`, label: 'The story so far', text: 'The last five elections.' },
];
---

<Base title={election.name} country={slug} lastChecked={oldestChecked(country, election)}>
  <h1 class="text-3xl font-semibold tracking-tight">{election.name}</h1>
  <p class="mt-3 max-w-prose text-lg text-muted">{country.intro}</p>

  <section class="mt-12" aria-labelledby="dates-heading">
    <h2 id="dates-heading" class="text-2xl font-semibold">Key dates</h2>
    <ol class="mt-4 divide-y divide-line rounded-xl border border-line">
      {
        dates.map((d) => (
          <li class="p-4">
            <p class="font-semibold"><time datetime={d.date}>{formatDate(d.date)}</time></p>
            <p>{d.label}</p>
            <SourceLink source_url={d.source_url} source_date={d.source_date} last_checked={d.last_checked} />
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-12" aria-labelledby="how-heading">
    <h2 id="how-heading" class="text-2xl font-semibold">How it works</h2>
    <ul class="mt-4 space-y-4">
      {country.how_it_works.map((card) => <li><ExplainerCard {...card} /></li>)}
    </ul>
  </section>

  <section class="mt-12" aria-labelledby="vote-heading">
    <h2 id="vote-heading" class="text-2xl font-semibold">How to vote</h2>
    <div class="mt-4 rounded-xl border border-line p-5"><StepList steps={country.how_to_vote} /></div>
  </section>

  <nav class="mt-12" aria-label="Next steps">
    <h2 class="text-2xl font-semibold">Keep going</h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-3">
      {
        links.map((l) => (
          <li class="relative rounded-xl border border-line p-5">
            <a href={l.href} class="font-semibold text-accent underline-offset-4 after:absolute after:inset-0 hover:underline">{l.label}</a>
            <p class="mt-1 text-muted">{l.text}</p>
          </li>
        ))
      }
    </ul>
  </nav>
</Base>
