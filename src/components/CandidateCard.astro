---
import Card from './Card.astro';
import Badge from './Badge.astro';
import type { Candidate } from '../lib/content';

interface Props {
  candidate: Candidate;
  country: string;
}
const { candidate, country } = Astro.props;
const { person, candidacy, slug } = candidate;
---

<Card as="li">
  <div class="relative">
    <h2 class="text-lg font-semibold leading-snug">
      <a href={`/${country}/candidates/${slug}/`} class="text-ink no-underline after:absolute after:inset-0 hover:text-accent hover:underline">
        {person.name}
      </a>
    </h2>
    <p class="mt-1 text-sm text-muted">{candidacy.profile.party} · {candidacy.profile.family}</p>
    <p class="mt-2">{candidacy.profile.one_line}</p>
    <p class="mt-3"><Badge>{candidacy.status === 'official' ? 'Official candidate' : 'Declared candidate'}</Badge></p>
  </div>
</Card>
