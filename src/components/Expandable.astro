---
import Chevron from './Chevron.astro';

interface Props {
  /** The always-visible label of the toggle. */
  label: string;
  /** Extra words read by screen readers only, e.g. "about {card title}". */
  context?: string;
  open?: boolean;
}
const { label, context, open = false } = Astro.props;
---

<!-- Native <details>: keyboard and screen-reader friendly, works without JavaScript. -->
<details class="group" open={open}>
  <summary class="flex min-h-11 items-center gap-2 py-2 text-sm font-medium text-accent">
    <span class="underline underline-offset-4">{label}{context && <span class="sr-only"> {context}</span>}</span>
    <Chevron />
  </summary>
  <div class="pt-1 pb-2"><slot /></div>
</details>
