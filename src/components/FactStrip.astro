---
import type { StoryFact } from '../lib/story';
import { numberWord, upperFirst } from '../lib/display';
interface Props {
  facts: StoryFact[];
  /** How many election cards the facts are calculated from. */
  count: number;
}
const { facts, count } = Astro.props;
const heading = `${upperFirst(numberWord(facts.length))} ${facts.length === 1 ? 'fact' : 'facts'} across ${count === 1 ? 'the election' : `all ${numberWord(count)} elections`}`;
const note = `Calculated from the ${count === 1 ? 'election card' : `${numberWord(count)} election cards`} below.`;
---

<section aria-labelledby="strip-heading">
  <h2 id="strip-heading" class="sr-only">{heading}</h2>
  <ul class="grid gap-3 sm:grid-cols-3">
    {
      facts.map((f) => (
        <li class="rounded-xl bg-accent-soft p-4">
          <p class="text-sm font-medium text-accent">{f.label}</p>
          <p class="mt-1 text-ink">{f.text}</p>
        </li>
      ))
    }
  </ul>
  <p class="mt-2 text-sm text-muted">{note}</p>
</section>
