---
import { formatDate } from '../lib/dates';

interface Props {
  source_url: string;
  source_date: string;
  last_checked: string;
  /** The page prints no date: source_date is the day we read it. */
  source_date_is_retrieval?: boolean;
}
const { source_url, source_date, last_checked, source_date_is_retrieval = false } = Astro.props;
const host = new URL(source_url).hostname.replace(/^www\./, '');
---

<p class="text-sm text-muted">
  Source:{' '}<a href={source_url} rel="noopener noreferrer" class="text-accent underline underline-offset-2">{host}</a>
  {source_date_is_retrieval ? (
    <>{' '}· page undated, read on <time datetime={source_date}>{formatDate(source_date)}</time></>
  ) : (
    <>
      {' '}· published <time datetime={source_date}>{formatDate(source_date)}</time>
      {' '}· checked <time datetime={last_checked}>{formatDate(last_checked)}</time>
    </>
  )}
</p>
